rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() {
      return request.auth != null && request.auth.token.email.lower() == "usuario.guit@gmail.com";
    }
    function ehMotorista() {
      return request.auth != null
        && exists(/databases/$(database)/documents/motoristas/$(request.auth.uid))
        && get(/databases/$(database)/documents/motoristas/$(request.auth.uid)).data.ativo == true;
    }
    match /motoristas/{uid} {
      allow read: if request.auth != null && (admin() || request.auth.uid == uid);
      allow write: if admin();
    }
    match /disponibilidade/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (admin() || (request.auth.uid == uid && ehMotorista()));
    }
    match /contagem/{uid} {
      allow read: if request.auth != null && (admin() || request.auth.uid == uid);
      allow write: if request.auth != null && request.auth.uid == uid && (admin() || ehMotorista());
    }
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || admin());
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if admin();
    }
    match /contatos/{id} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read: if request.auth != null && (admin() || resource.data.uid == request.auth.uid
        || (ehMotorista() && get(/databases/$(database)/documents/chamados/$(id)).data.motoristaId == request.auth.uid));
      allow delete: if admin();
    }
    match /chamados/{id} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == "aguardando"
        && request.resource.data.get("referencia", "").size() <= 120;
      allow read: if request.auth != null && (admin() || resource.data.uid == request.auth.uid
        || (ehMotorista() && (resource.data.status == "aguardando" || resource.data.motoristaId == request.auth.uid)));
      allow update: if request.auth != null && (admin()
        || (ehMotorista() && resource.data.status == "aguardando"
            && request.resource.data.status == "aceito"
            && request.resource.data.motoristaId == request.auth.uid)
        || (ehMotorista() && resource.data.motoristaId == request.auth.uid
            && request.resource.data.status == "finalizado")
        || (resource.data.uid == request.auth.uid && request.resource.data.status == "cancelado"
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])));
      allow delete: if admin() && resource.data.status in ["finalizado", "cancelado"];
    }
  }
}
